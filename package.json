{
  "name": "bondageclub-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A static, low-bandwidth Bondage Club chat client.",
  "scripts": {
    "dev": "vite",
    "dev:relay": "wrangler pages dev dist --ip 127.0.0.1 --port 8788 --compatibility-date 2026-09-01",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awdrrawd/BondageClub-Lite.git"
  },
  "license": "MIT",
  "dependencies": {
    "lz-string": "^1.5.0",
    "socket.io-client": "4.8.3"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "happy-dom": "^20.14.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "4.130.0"
  }
}
